{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
	{ "source": "/index", "destination": "/index.html" },
	{ "source": "/index.html", "destination": "/index.html" },
    { "source": "/index2", "destination": "/index2.html" },
    { "source": "/index2.html", "destination": "/index2.html" },
	{ "source": "/old", "destination": "/old.html" },
	{ "source": "/old.html", "destination": "/old.html" },
  { "source": "/ref/(.*)", "destination": "/ref-redirect.html" },
  { "source": "/r/(.*)", "destination": "/ref-redirect.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
